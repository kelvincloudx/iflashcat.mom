---
interface Props {
  size?: number;
  showText?: boolean;
}

const { size = 32, showText = true } = Astro.props;
---

<a href="/" class="brand-logo" aria-label="闪电猫 SpeedCAT 首页">
  <div class="logo-icon-wrap" style={`width: ${size}px; height: ${size}px;`}>
    <svg
      viewBox="0 0 40 40"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="logo-svg"
      aria-hidden="true"
    >
      <!-- Background hexagon/circle glow -->
      <circle cx="20" cy="20" r="19" fill="#111827" stroke="rgba(56, 189, 248, 0.4)" stroke-width="1.5" />
      
      <!-- Minimalist Cat Silhouette Ears & Head Outline -->
      <path
        d="M10 27V15L14 18C15.8 17.3 17.8 17 20 17C22.2 17 24.2 17.3 26 18L30 15V27C30 31.4 25.5 34 20 34C14.5 34 10 31.4 10 27Z"
        fill="#1E293B"
        stroke="#38BDF8"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
      
      <!-- Cat ears inner accent -->
      <polygon points="12,17 14,21 16,19" fill="rgba(56, 189, 248, 0.25)" />
      <polygon points="28,17 26,21 24,19" fill="rgba(56, 189, 248, 0.25)" />

      <!-- High-Energy Lightning Bolt in Center -->
      <path
        d="M21.5 9L15 22H20.5L18.5 31L26 19H20.5L21.5 9Z"
        fill="#FFD43B"
        stroke="#0B1020"
        stroke-width="1"
        stroke-linejoin="round"
        filter="drop-shadow(0 0 3px rgba(255, 212, 59, 0.8))"
      />
    </svg>
  </div>

  {showText && (
    <div class="brand-text">
      <span class="brand-name">闪电猫</span>
      <span class="brand-sub">SpeedCAT</span>
    </div>
  )}
</a>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--color-text-main);
  }

  .logo-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .logo-svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.3));
    transition: transform var(--transition-fast);
  }

  .brand-logo:hover .logo-svg {
    transform: scale(1.05);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-name {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #F8FAFC;
    background: linear-gradient(135deg, #FFFFFF 30%, #38BDF8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .brand-sub {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-yellow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
