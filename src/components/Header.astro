---
import Logo from './Logo.astro';
import { NAV_LINKS } from '../data/site';
import { AFF_LINK, AFF_REL, AFF_TARGET, AFF_BUTTON_TEXT } from '../data/plans';

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-container">
    <div class="header-left">
      <Logo size={36} showText={true} />
    </div>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="主导航">
      <ul class="nav-list">
        {NAV_LINKS.map((item) => {
          const isActive =
            item.href === '/'
              ? pathname === '/'
              : pathname.startsWith(item.href);
          return (
            <li class="nav-item">
              <a
                href={item.href}
                class:list={['nav-link', { active: isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-right">
      <a
        href={AFF_LINK}
        target={AFF_TARGET}
        rel={AFF_REL}
        class="btn btn-primary btn-sm header-cta"
      >
        <svg class="cta-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" fill="currentColor"></polygon>
        </svg>
        {AFF_BUTTON_TEXT}
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button
        id="mobile-nav-toggle"
        class="mobile-toggle"
        aria-label="切换导航菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
    <div class="container mobile-menu-inner">
      <ul class="mobile-nav-list">
        {NAV_LINKS.map((item) => {
          const isActive =
            item.href === '/'
              ? pathname === '/'
              : pathname.startsWith(item.href);
          return (
            <li>
              <a
                href={item.href}
                class:list={['mobile-nav-link', { active: isActive }]}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
      <div class="mobile-cta-wrap">
        <a
          href={AFF_LINK}
          target={AFF_TARGET}
          rel={AFF_REL}
          class="btn btn-primary btn-block"
        >
          {AFF_BUTTON_TEXT}
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(11, 16, 32, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(56, 189, 248, 0.15);
    height: 72px;
  }

  .header-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.5rem 0.25rem;
    position: relative;
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-text-main);
  }

  .nav-link.active {
    color: var(--color-cyan);
    font-weight: 600;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-cyan);
    border-radius: 2px;
    box-shadow: 0 0 8px var(--color-cyan);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .cta-icon {
    margin-right: 0.25rem;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    padding: 8px;
    color: var(--color-text-main);
  }

  .hamburger-line {
    display: block;
    width: 20px;
    height: 2px;
    background-color: var(--color-text-main);
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .mobile-menu {
    display: none;
    position: absolute;
    top: 72px;
    left: 0;
    right: 0;
    background: rgba(17, 24, 39, 0.98);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    padding: 1.5rem 0;
  }

  .mobile-menu.open {
    display: block;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0;
    margin: 0 0 1.5rem 0;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem 1rem;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.02);
  }

  .mobile-nav-link.active {
    color: var(--color-cyan);
    background: rgba(56, 189, 248, 0.1);
    font-weight: 600;
    border-left: 3px solid var(--color-cyan);
  }

  .mobile-cta-wrap {
    padding-top: 0.5rem;
  }

  @media (max-width: 860px) {
    .desktop-nav {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .header-cta {
      display: none;
    }
  }
</style>

<script>
  function setupMobileMenu() {
    const toggle = document.getElementById('mobile-nav-toggle');
    const menu = document.getElementById('mobile-menu');

    if (!toggle || !menu) return;

    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.setAttribute('aria-hidden', isExpanded.toString());
      menu.classList.toggle('open');
    });

    // Close when clicking a link
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        menu.setAttribute('aria-hidden', 'true');
      });
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
